# Copy to .env in the config home (gitignored), or run `crawlmark-cli setup`, which writes it for you with mode 0600.
# Relative paths below resolve against the config home, not the working directory.
#
# Config home: CRAWLMARK_HOME if set; else the project root for a source checkout (a .git directory, src/ next to dist/,
# or an existing .env or config/clients.yaml there); else ~/.crawlmark. CRAWLMARK_HOME itself can't be set in this file
# (the file is found through it): set it in your shell or the MCP client's server env. `crawlmark-cli setup migrate --to <dir>`
# copies an existing home somewhere else.
# CRAWLMARK_HOME=~/.crawlmark

# Google (Search Console + GA4) is optional. Without it, DataForSEO, Lighthouse and axe still work.
# How the server signs in to Google: oauth or service_account. Leave unset to auto-detect:
#   service_account if GOOGLE_APPLICATION_CREDENTIALS is set, else oauth if both OAuth client vars are set, else no Google.
#   oauth: a person signs in once with `crawlmark-cli auth login`; the token is stored at DATA_DIR/google-token.json.
#   service_account: uses the JSON key at GOOGLE_APPLICATION_CREDENTIALS (also for unattended jobs).
GOOGLE_AUTH_MODE=

# OAuth client of type "Desktop app" from Google Cloud > Google Auth Platform > Clients. Required in oauth mode.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Path to a Google service-account JSON key. Required in service_account mode, ignored in oauth mode.
# Setting it turns on service_account mode when GOOGLE_AUTH_MODE is unset.
GOOGLE_APPLICATION_CREDENTIALS=

# DataForSEO API credentials from https://app.dataforseo.com/api-access (the API password, not the account password).
# Needed for paid tools. `crawlmark-cli setup --step dataforseo` checks them for free and saves them.
DATAFORSEO_LOGIN=your-login@example.com
DATAFORSEO_PASSWORD=your-api-password

# Sandbox is free and returns fake data. Use https://api.dataforseo.com/v3 for real data.
DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com/v3
# Alternative to the URL: DATAFORSEO_LIVE=true selects the live API when DATAFORSEO_BASE_URL is unset (the Claude Desktop bundle uses this).
# DATAFORSEO_LIVE=false

# Default provider for paid keyword, ranking, competitor and backlink data: dataforseo, ahrefs or semrush (any case).
# Blank means dataforseo. An unknown value doesn't stop the server; setup_status and every paid call report it.
# A client's dataProvider in clients.yaml overrides it. Live SERPs, on-page checks and crawls always use DataForSEO.
# `crawlmark-cli setup --step provider` sets it.
SEO_DATA_PROVIDER=

# Ahrefs API v3 key (optional): keyword volumes, rankings, competitors and backlinks from Ahrefs instead of DataForSEO.
# Needs the Lite plan or higher. Create it under Account settings > API keys (https://app.ahrefs.com/account/api-keys;
# only workspace owners and admins can open that page). `crawlmark-cli setup --step ahrefs` checks it for free and saves it.
AHREFS_API_KEY=
# Ahrefs API units crawlmark may use per calendar month (UTC), across all clients, and per client by default
# (a client's monthlyUnits.ahrefs in clients.yaml overrides the per-client value). Units are never converted to dollars.
AHREFS_MONTHLY_UNIT_CAP=50000
DEFAULT_CLIENT_MONTHLY_AHREFS_UNITS=10000

# Semrush (optional): keyword volumes, rankings, competitors and backlinks from Semrush. Needs an SEO Toolkit Business
# plan plus a separately bought API unit package (the balance is zero right after the upgrade).
# SEMRUSH_API_KEY is the v3 key, under Subscription info > API units; it is used for every v3 report and the free
# balance check. `crawlmark-cli setup --step semrush` checks it for free and saves it.
SEMRUSH_API_KEY=
# Optional v4 key (your Semrush profile > API keys). When set, backlinks use the v4 overview; when unset, the older v3
# report. Semrush has no free check for v4 keys, so it is first checked when backlinks_summary runs.
SEMRUSH_V4_API_KEY=
# Semrush API units crawlmark may use per calendar month (UTC), across all clients, and per client by default
# (a client's monthlyUnits.semrush in clients.yaml overrides the per-client value).
SEMRUSH_MONTHLY_UNIT_CAP=20000
DEFAULT_CLIENT_MONTHLY_SEMRUSH_UNITS=5000

# Testing only (leave unset): point the Ahrefs and Semrush clients at a local fake server. Read from the shell
# environment only; values in this file are ignored, and setup never writes them. https, or plain http to
# 127.0.0.1 / localhost / [::1] only; the server and `setup` print a stderr line while one is in use.
# AHREFS_BASE_URL=
# SEMRUSH_BASE_URL=
# SEMRUSH_BALANCE_URL=

# PageSpeed Insights API key (optional; adds real-user field data to lighthouse).
PSI_API_KEY=

# The client list. Discovered Search Console / GA4 domains are added to it automatically, and you can
# add your own (`crawlmark-cli clients add <domain>`). Created when first needed. See config/clients.example.yaml.
CLIENTS_FILE=./config/clients.yaml

# Defaults for discovered clients (and clients.yaml entries that leave these out).
# DataForSEO location code (2840 = United States) and language code.
DEFAULT_LOCATION_CODE=2840
DEFAULT_LANGUAGE_CODE=en
# Per-client monthly cap for paid data, in USD.
DEFAULT_CLIENT_MONTHLY_BUDGET_USD=5

# Extra rules for the suggest_competitors denylist (on top of the built-in list of social, review, marketplace,
# encyclopedia, video and big-box sites and .gov/.edu). A file with one rule per line (optional; gitignored by default)
# and/or a comma-separated list. Rules: domain.example (and subdomains), *.suffix, name.* (any short suffix), !domain (exempt).
COMPETITOR_DENYLIST_FILE=./config/competitor-denylist.txt
COMPETITOR_DENYLIST=

# Directory for the SQLite cache, spend ledger and Google OAuth token.
DATA_DIR=./data

# Hard monthly cap across all clients, in USD.
GLOBAL_MONTHLY_BUDGET_USD=50

# Optional: path to a Chrome/Chromium binary for Lighthouse and axe (read directly, not via config).
# CHROME_PATH=

# Chrome's sandbox is on by default. Set to true only where it cannot start (it is added automatically on Linux as root).
# CHROME_NO_SANDBOX=

# Set to true to let lighthouse, accessibility_check, render_check and audits reach loopback/private addresses
# (local development only). Without it, hostnames that resolve to such an address are refused, and headless Chrome's
# egress proxy blocks them for every request the page makes.
ALLOW_PRIVATE_URLS=

# Set to true to only accept URLs on a client domain (or a subdomain of one) from the client list, for lighthouse,
# accessibility_check, render_check and run_audit `urls`. Resources the page loads are not restricted (they still pass
# the private-address check). Values other than true/false are refused, so a typo never silently turns it off.
RESTRICT_TO_CLIENT_DOMAINS=

# Scheduled runs (crawlmark-cli check-traffic / audit): alert when non-branded clicks fall by at least this percent...
ALERT_TRAFFIC_DROP_PCT=25
# ...and by at least this many clicks (avoids alerts on tiny sites).
ALERT_MIN_CLICKS_LOST=50
# Optional incoming webhook (Slack-style) that gets {"text": "..."} when there are alerts. Must be https. Keep it secret.
ALERT_WEBHOOK_URL=

# Testing the setup wizard only (leave unset): use this Claude Desktop config file and this `claude` binary
# instead of the real ones. Read from the shell environment only; values in this file are ignored.
# CRAWLMARK_CLAUDE_DESKTOP_CONFIG=
# CRAWLMARK_CLAUDE_BIN=
