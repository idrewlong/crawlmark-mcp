{
  "name": "crawlmark-mcp",
  "version": "0.3.0",
  "description": "MCP server for automated SEO audits and reports: Google Search Console, GA4, Tag Manager, DataForSEO, Lighthouse and axe-core",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "seo-audit",
    "google-search-console",
    "ga4",
    "dataforseo",
    "lighthouse",
    "axe-core",
    "claude"
  ],
  "homepage": "https://github.com/idrewlong/crawlmark-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idrewlong/crawlmark-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/idrewlong/crawlmark-mcp/issues"
  },
  "author": "Andrew Long (https://github.com/idrewlong)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "crawlmark-mcp": "dist/index.js",
    "crawlmark-cli": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    ".env.example",
    "config/clients.example.yaml"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/prompts/templates', 'dist/prompts/templates', { recursive: true })\"",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "cli": "node --disable-warning=ExperimentalWarning dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:live": "vitest run -c test/live/vitest.config.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "prepublishOnly": "node scripts/prepublish-guard.mjs && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.2",
    "docx": "9.10.0",
    "googleapis": "^185.0.0",
    "lighthouse": "^13.5.0",
    "puppeteer": "^25.13.0",
    "re2js": "2.8.8",
    "smol-toml": "1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jszip": "^3.10.2",
    "marked": "^18.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
